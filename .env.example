# LOCAL BIZ — Environment Configuration Template (.env.example)

# 1. Base Application & Geographic Defaults
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=chennai
NEXT_PUBLIC_DEFAULT_STATE=tamil-nadu
NEXT_PUBLIC_DEFAULT_COUNTRY=india
NEXT_PUBLIC_APP_NAME="Local Biz"

# 2. Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# 3. Razorpay Payments & Billing (INR integer paise)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 4. Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Local Biz <support@localbiz.in>"

# 5. SMS / OTP Verification (defaults to safe mock in development)
SMS_PROVIDER=mock
SMS_API_KEY=

# 6. Analytics & Anti-Abuse (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# 7. Error Reporting
SENTRY_DSN=
